{
  "labelPosition": "top",
  "size": "large",
  "formItems": [
    {
      "itemProps": {
        "prop": "text0"
      },
      "colProps": {
        "span": 24
      },
      "componentProps": {
        "slots": {
          "default": {
            "html": "<h2 class=\"text-2xl font-bold text-center w-[100%]\">登录</h2>"
          }
        }
      }
    },
    {
      "itemProps": {
        "prop": "userCode",
        "label": "login.username"
      },
      "colProps": {
        "span": 24
      },
      "componentProps": {
        "component": "Input",
        "placeholder": "admin",
        "defValue": "admin"
      }
    },
    {
      "itemProps": {
        "prop": "password",
        "label": "login.password"
      },
      "colProps": {
        "span": 24
      },
      "componentProps": {
        "component": "InputPassword",
        "placeholder": "0kya.top!",
        "defValue": "0kya.top!"
      }
    },
    {
      "itemProps": {
        "prop": "captchaCode",
        "label": "login.code"
      },
      "colProps": {
        "span": 24
      },
      "componentProps": {
        "component": "Captcha",
        "type": "math"
      },
      "hidden": false
    },
    {
      "itemProps": {
        "prop": "remember"
      },
      "colProps": {
        "span": 6
      },
      "componentProps": {
        "component": "Checkbox",
        "label": "login.remember"
      }
    },
    {
      "itemProps": {
        "prop": "button1"
      },
      "colProps": {
        "span": 24,
        "style": "margin-top: 50px"
      },
      "componentProps": {
        "component": "Button",
        "type": "primary",
        "staticText": "登录",
        "on": {
          "click": "() => {\n  this.login()\n        }"
        }
      }
    }
  ],
  "formValidators": {
    "userCode": [
      {
        "required": true,
        "message": "必填"
      },
      {
        "validator": "(_, val, callback) => {\n        if (val?.indexOf(' ') !== -1) {\n        callback(new Error('不能包含空格'))\n      } else {\n        callback()\n      }\n    }"
      }
    ],
    "password": [
      {
        "required": true,
        "message": "必填"
      }
    ],
    "captchaCode": [
      {
        "required": true,
        "message": "必填"
      }
    ]
  },
  "lifecycle": {
    "mounted": "() => {\nthis.formData.remember = this.userStore.getRememberMe \n  if(this.userStore.getRememberMe && this.userStore.getLoginInfo !== void 0){\n    this.formData.userCode = this.userStore.getLoginInfo.userCode\n    this.formData.password = this.userStore.getLoginInfo.password\n  }\n}"
  }
}
